<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_membership_service_type_tree" model="ir.ui.view">
        <field name="name">membership.service.type.tree</field>
        <field name="model">membership.service.type</field>
        <field name="arch" type="xml">
            <tree string="أنواع خدمات الأطباء">
                <field name="name"/>
                <field name="company_id"/>
                <field name="product_id"/>
                <field name="invoice_template_id" optional="hide"/>
                <field name="fee"/>
                <field name="requires_active_membership"/>
                <field name="requires_attachments"/>
                <field name="generates_invoice"/>
                <field name="requires_revenue_distribution"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_membership_service_type_form" model="ir.ui.view">
        <field name="name">membership.service.type.form</field>
        <field name="model">membership.service.type</field>
        <field name="arch" type="xml">
            <form string="نوع خدمة طبيب">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="active"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="generates_invoice"/>
                            <field name="invoice_template_id" options="{'no_create': True}" invisible="not generates_invoice"/>
                            <field name="product_id" options="{'no_create': True}" invisible="not generates_invoice"/>
                            <field name="fee" invisible="not generates_invoice"/>
                            <field name="requires_revenue_distribution" invisible="not generates_invoice"/>
                        </group>
                    </group>
                    <group string="المتطلبات">
                        <field name="requires_active_membership"/>
                        <field name="requires_attachments"/>
                    </group>
                    <group string="الملاحظات">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_membership_service_type_search" model="ir.ui.view">
        <field name="name">membership.service.type.search</field>
        <field name="model">membership.service.type</field>
        <field name="arch" type="xml">
            <search string="بحث أنواع خدمات الأطباء">
                <field name="name"/>
                <field name="company_id"/>
                <field name="product_id"/>
                <filter string="نشط" name="active" domain="[('active', '=', True)]"/>
                <filter string="مؤرشف" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="تجميع حسب">
                    <filter string="الشركة" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_membership_service_type" model="ir.actions.act_window">
        <field name="name">أنواع خدمات الأطباء</field>
        <field name="res_model">membership.service.type</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_membership_service_type_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
