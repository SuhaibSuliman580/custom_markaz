<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_membership" model="ir.module.category">
            <field name="name">Membership</field>
            <field name="sequence">50</field>
        </record>

        <record id="group_membership_officer" model="res.groups">
            <field name="name">Membership Officer</field>
            <field name="category_id" ref="module_category_membership"/>
            <field name="comment">Can manage membership applications and view memberships.</field>
        </record>

        <record id="group_membership_admin" model="res.groups">
            <field name="name">Membership Admin</field>
            <field name="category_id" ref="module_category_membership"/>
            <field name="implied_ids" eval="[(4, ref('group_membership_officer'))]"/>
            <field name="comment">Full access to all membership management features.</field>
        </record>

    </data>

    <data noupdate="1">
        <record id="rule_application_portal_user" model="ir.rule">
            <field name="name">Membership Application: Portal User Own</field>
            <field name="model_id" ref="model_membership_application"/>
            <field name="domain_force">['&amp;', ('partner_id', '=', user.partner_id.id), '|', ('partner_id.company_id', '=', False), ('partner_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_period_portal_user" model="ir.rule">
            <field name="name">Membership Period: Portal User Own</field>
            <field name="model_id" ref="model_membership_period"/>
            <field name="domain_force">['&amp;', ('partner_id', '=', user.partner_id.id), '|', ('partner_id.company_id', '=', False), ('partner_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_application_officer" model="ir.rule">
            <field name="name">Membership Application: Officer</field>
            <field name="model_id" ref="model_membership_application"/>
            <field name="domain_force">['|', ('partner_id.company_id', '=', False), ('partner_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_membership_officer'))]"/>
        </record>

        <record id="rule_period_officer" model="ir.rule">
            <field name="name">Membership Period: Officer</field>
            <field name="model_id" ref="model_membership_period"/>
            <field name="domain_force">['|', ('partner_id.company_id', '=', False), ('partner_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_membership_officer'))]"/>
        </record>

        <record id="rule_application_admin" model="ir.rule">
            <field name="name">Membership Application: Admin</field>
            <field name="model_id" ref="model_membership_application"/>
            <field name="domain_force">['|', ('partner_id.company_id', '=', False), ('partner_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_membership_admin'))]"/>
        </record>

        <record id="rule_period_admin" model="ir.rule">
            <field name="name">Membership Period: Admin</field>
            <field name="model_id" ref="model_membership_period"/>
            <field name="domain_force">['|', ('partner_id.company_id', '=', False), ('partner_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_membership_admin'))]"/>
        </record>

        <record id="rule_profile_update_officer" model="ir.rule">
            <field name="name">Membership Profile Update: Officer</field>
            <field name="model_id" ref="model_membership_profile_update"/>
            <field name="domain_force">['|', ('partner_id.company_id', '=', False), ('partner_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_membership_officer'))]"/>
        </record>

        <record id="rule_profile_update_admin" model="ir.rule">
            <field name="name">Membership Profile Update: Admin</field>
            <field name="model_id" ref="model_membership_profile_update"/>
            <field name="domain_force">['|', ('partner_id.company_id', '=', False), ('partner_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_membership_admin'))]"/>
        </record>

        <record id="rule_medical_specialty_portal" model="ir.rule">
            <field name="name">Medical Specialty: Portal Multi Company</field>
            <field name="model_id" ref="model_medical_specialty"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_medical_specialty_officer" model="ir.rule">
            <field name="name">Medical Specialty: Officer Multi Company</field>
            <field name="model_id" ref="model_medical_specialty"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_membership_officer'))]"/>
        </record>

        <record id="rule_medical_specialty_admin" model="ir.rule">
            <field name="name">Medical Specialty: Admin Multi Company</field>
            <field name="model_id" ref="model_medical_specialty"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_membership_admin'))]"/>
        </record>

        <record id="rule_medical_unv_admin" model="ir.rule">
            <field name="name">Medical University: Admin Multi Company</field>
            <field name="model_id" ref="model_medical_unv"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_membership_admin'))]"/>
        </record>

        <record id="rule_medical_unv_portal" model="ir.rule">
            <field name="name">Medical University: Portal Multi Company</field>
            <field name="model_id" ref="model_medical_unv"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

    </data>
</odoo>
