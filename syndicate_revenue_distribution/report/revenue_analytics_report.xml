<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_report_revenue_analytics" model="ir.actions.report">
        <field name="name">Revenue Analytics Report</field>
        <field name="model">syndicate.revenue.analytics.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">syndicate_revenue_distribution.report_revenue_analytics_document</field>
        <field name="report_file">syndicate_revenue_distribution.report_revenue_analytics_document</field>
        <field name="print_report_name">object._get_report_base_filename()</field>
        <field name="binding_model_id" ref="model_syndicate_revenue_analytics_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_revenue_analytics_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif;">
                        <style>
                            .ra-title { text-align: center; font-size: 22px; font-weight: bold; margin-bottom: 16px; }
                            .ra-section { margin-top: 18px; font-size: 15px; font-weight: bold; border-bottom: 1px solid #777; padding-bottom: 4px; }
                            .ra-table { width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 12px; }
                            .ra-table th { background: #0F6B7A; color: #fff; border: 1px solid #999; padding: 5px; text-align: left; }
                            .ra-table td { border: 1px solid #bbb; padding: 5px; }
                            .ra-meta th { width: 18%; background: #f2f2f2; color: #333; }
                            .ra-number { text-align: right; white-space: nowrap; }
                        </style>

                        <div class="ra-title">Revenue Analytics Report</div>

                        <table class="ra-table ra-meta">
                            <tr>
                                <th>Company</th>
                                <td><span t-esc="o.company_id.name or ''"/></td>
                                <th>Generated At</th>
                                <td><span t-esc="o._get_generated_at_text()"/></td>
                            </tr>
                            <tr>
                                <th>Date From</th>
                                <td><span t-esc="o.date_from or ''"/></td>
                                <th>Date To</th>
                                <td><span t-esc="o.date_to or ''"/></td>
                            </tr>
                            <tr>
                                <th>Generated By</th>
                                <td><span t-esc="o.env.user.name or ''"/></td>
                                <th>Fund Box</th>
                                <td><span t-esc="o.fund_box_id.name or ''"/></td>
                            </tr>
                            <tr>
                                <th>Product</th>
                                <td><span t-esc="o.product_id.name or ''"/></td>
                                <th>Partner</th>
                                <td><span t-esc="o.partner_id.name or ''"/></td>
                            </tr>
                        </table>

                        <div class="ra-section">Executive KPIs</div>
                        <table class="ra-table">
                            <tr>
                                <th>Total Distributed Amount</th>
                                <th>Total Revenue</th>
                                <th>Total Invoices</th>
                                <th>Total Ledger Lines</th>
                                <th>Average / Invoice</th>
                                <th>Average / Product</th>
                            </tr>
                            <tr>
                                <td class="ra-number"><span t-esc="'%.2f' % (o.total_distributed_amount or 0.0)"/></td>
                                <td class="ra-number"><span t-esc="'%.2f' % (o.total_revenue or 0.0)"/></td>
                                <td class="ra-number"><span t-esc="o.total_invoice_count or 0"/></td>
                                <td class="ra-number"><span t-esc="o.total_ledger_line_count or 0"/></td>
                                <td class="ra-number"><span t-esc="'%.2f' % (o.average_distribution_per_invoice or 0.0)"/></td>
                                <td class="ra-number"><span t-esc="'%.2f' % (o.average_distribution_per_product or 0.0)"/></td>
                            </tr>
                        </table>

                        <div class="ra-section">Top 10 Fund Boxes</div>
                        <table class="ra-table">
                            <tr>
                                <th>Rank</th>
                                <th>Fund Box</th>
                                <th>Distributed Amount</th>
                                <th>Percentage of Total</th>
                            </tr>
                            <tr t-foreach="o.fund_box_line_ids" t-as="line">
                                <td class="ra-number"><span t-esc="line.rank"/></td>
                                <td><span t-esc="line.fund_box_name"/></td>
                                <td class="ra-number"><span t-esc="'%.2f' % (line.distributed_amount or 0.0)"/></td>
                                <td class="ra-number"><span t-esc="('%.2f' % (line.percentage_of_total or 0.0)) + '%'"/></td>
                            </tr>
                        </table>

                        <div class="ra-section">Top 10 Products</div>
                        <table class="ra-table">
                            <tr>
                                <th>Rank</th>
                                <th>Product</th>
                                <th>Distributed Amount</th>
                                <th>Percentage of Total</th>
                            </tr>
                            <tr t-foreach="o.product_line_ids" t-as="line">
                                <td class="ra-number"><span t-esc="line.rank"/></td>
                                <td><span t-esc="line.product_name"/></td>
                                <td class="ra-number"><span t-esc="'%.2f' % (line.distributed_amount or 0.0)"/></td>
                                <td class="ra-number"><span t-esc="('%.2f' % (line.percentage_of_total or 0.0)) + '%'"/></td>
                            </tr>
                        </table>

                        <div class="ra-section">Top 10 Partners</div>
                        <table class="ra-table">
                            <tr>
                                <th>Rank</th>
                                <th>Partner</th>
                                <th>Distributed Amount</th>
                                <th>Percentage of Total</th>
                            </tr>
                            <tr t-foreach="o.partner_line_ids" t-as="line">
                                <td class="ra-number"><span t-esc="line.rank"/></td>
                                <td><span t-esc="line.partner_name"/></td>
                                <td class="ra-number"><span t-esc="'%.2f' % (line.distributed_amount or 0.0)"/></td>
                                <td class="ra-number"><span t-esc="('%.2f' % (line.percentage_of_total or 0.0)) + '%'"/></td>
                            </tr>
                        </table>

                        <div class="ra-section">Monthly Revenue Trend</div>
                        <table class="ra-table">
                            <tr>
                                <th>Month</th>
                                <th>Revenue</th>
                                <th>Distributed Amount</th>
                                <th>Invoice Count</th>
                            </tr>
                            <tr t-foreach="o.month_line_ids" t-as="line">
                                <td><span t-esc="line.month"/></td>
                                <td class="ra-number"><span t-esc="'%.2f' % (line.revenue or 0.0)"/></td>
                                <td class="ra-number"><span t-esc="'%.2f' % (line.distributed_amount or 0.0)"/></td>
                                <td class="ra-number"><span t-esc="line.invoice_count"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
