<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_syndicate_revenue_dashboard_wizard_form" model="ir.ui.view">
        <field name="name">syndicate.revenue.dashboard.wizard.form</field>
        <field name="model">syndicate.revenue.dashboard.wizard</field>
        <field name="arch" type="xml">
            <form string="Revenue Dashboard">
                <sheet>
                    <group string="Filters">
                        <group>
                            <field name="period_type"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="fund_box_id"/>
                            <field name="product_id"/>
                            <field name="partner_id"/>
                        </group>
                    </group>

                    <separator string="KPIs"/>
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-sm-6 col-lg">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="text-muted fw-bold mb-2">Total Distributed Amount</div>
                                    <field name="total_distributed_amount"
                                           readonly="1"
                                           nolabel="1"
                                           widget="monetary"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="text-muted fw-bold mb-2">Total Invoices</div>
                                    <field name="total_invoice_count" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="text-muted fw-bold mb-2">Total Ledger Lines</div>
                                    <field name="total_ledger_line_count" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="text-muted fw-bold mb-2">Total Fund Boxes</div>
                                    <field name="total_fund_box_count" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="text-muted fw-bold mb-2">Total Products</div>
                                    <field name="total_product_count" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <page string="Top Fund Boxes">
                            <field name="fund_box_line_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="fund_box_id" column_invisible="1"/>
                                    <field name="rank" width="48px"/>
                                    <field name="fund_box_name" string="Fund Box" width="320px"/>
                                    <field name="amount" string="Amount" widget="monetary" width="140px"/>
                                    <field name="percentage_of_total"
                                           string="Percentage"
                                           widget="float"
                                           digits="[16, 2]"
                                           width="120px"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Top Products">
                            <field name="product_line_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="product_id" column_invisible="1"/>
                                    <field name="rank" width="48px"/>
                                    <field name="product_name" string="Product" width="360px"/>
                                    <field name="amount" string="Amount" widget="monetary" width="140px"/>
                                    <field name="percentage_of_total"
                                           string="Percentage"
                                           widget="float"
                                           digits="[16, 2]"
                                           width="120px"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Latest Ledger Lines">
                            <field name="latest_line_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="ledger_id" column_invisible="1"/>
                                    <field name="invoice_date" string="Invoice Date" width="120px"/>
                                    <field name="move_id" string="Invoice" width="160px"/>
                                    <field name="partner_name" width="180px"/>
                                    <field name="product_name" width="260px"/>
                                    <field name="fund_box_name" width="220px"/>
                                    <field name="distributed_amount"
                                           string="Distributed Amount"
                                           widget="monetary"
                                           width="160px"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_generate_dashboard"
                            type="object"
                            string="Generate Dashboard / إنشاء لوحة المعلومات"
                            class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_syndicate_revenue_dashboard_wizard" model="ir.actions.act_window">
        <field name="name">Revenue Dashboard</field>
        <field name="res_model">syndicate.revenue.dashboard.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_revenue_distribution_dashboard"
              name="Revenue Dashboard"
              parent="menu_syndicate_reporting"
              action="action_syndicate_revenue_dashboard_wizard"
              sequence="12"/>

</odoo>
