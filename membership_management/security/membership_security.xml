<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <delete model="ir.rule" search="[('domain_force', 'ilike', 'cashier_user_ids')]"/>

        <record id="module_category_membership" model="ir.module.category">
            <field name="name">Membership</field>
            <field name="sequence">50</field>
        </record>

        <record id="group_membership_officer" model="res.groups">
            <field name="name">Membership Officer</field>
            <field name="category_id" ref="module_category_membership"/>
            <field name="comment">Can manage membership applications and view memberships.</field>
        </record>

        <record id="group_membership_admin" model="res.groups">
            <field name="name">Membership Admin</field>
            <field name="category_id" ref="module_category_membership"/>
            <field name="implied_ids" eval="[(4, ref('group_membership_officer'))]"/>
            <field name="comment">Full access to all membership management features.</field>
        </record>

        <record id="group_doctor_data_employee" model="res.groups">
            <field name="name">Doctor Data Employee</field>
            <field name="category_id" ref="module_category_membership"/>
            <field name="implied_ids" eval="[(4, ref('group_membership_officer'))]"/>
            <field name="comment">Can collect and submit doctor data within allowed companies.</field>
        </record>

        <record id="group_doctor_data_reviewer" model="res.groups">
            <field name="name">Doctor Data Reviewer</field>
            <field name="category_id" ref="module_category_membership"/>
            <field name="implied_ids" eval="[(4, ref('group_membership_officer'))]"/>
            <field name="comment">Can review, return, and approve doctor data requests within allowed companies.</field>
        </record>

        <record id="group_doctor_data_executor" model="res.groups">
            <field name="name">تنفيذ تحديثات ملفات الأطباء</field>
            <field name="category_id" ref="module_category_membership"/>
            <field name="implied_ids" eval="[(4, ref('group_membership_officer'))]"/>
            <field name="comment">Can execute approved doctor data requests on doctor profiles within allowed companies.</field>
        </record>

        <record id="group_membership_service_registration" model="res.groups">
            <field name="name">Membership Service Registration</field>
            <field name="category_id" ref="module_category_membership"/>
            <field name="implied_ids" eval="[(4, ref('group_membership_officer'))]"/>
            <field name="comment">Can create and process membership service requests without registering payments.</field>
        </record>

        <record id="group_membership_service_finance" model="res.groups">
            <field name="name">Membership Service Finance</field>
            <field name="category_id" ref="module_category_membership"/>
            <field name="implied_ids" eval="[(4, ref('group_membership_officer')), (4, ref('account.group_account_invoice'))]"/>
            <field name="comment">Can approve financial service requests and generate invoices.</field>
        </record>

        <record id="group_membership_service_cashier" model="res.groups">
            <field name="name">Membership Service Cashier</field>
            <field name="category_id" ref="module_category_membership"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
            <field name="comment">Can view service requests and use the normal accounting payment flow.</field>
        </record>

        <record id="group_membership_service_manager" model="res.groups">
            <field name="name">Membership Service Manager</field>
            <field name="category_id" ref="module_category_membership"/>
            <field name="implied_ids" eval="[(4, ref('group_membership_service_registration')), (4, ref('group_membership_service_finance')), (4, ref('group_membership_service_cashier')), (4, ref('group_membership_admin'))]"/>
            <field name="comment">Can manage and cancel membership service requests and configure service types.</field>
        </record>

    </data>

