<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_revenue_distribution_template_tree" model="ir.ui.view">
        <field name="name">syndicate.revenue.distribution.template.tree</field>
        <field name="model">syndicate.revenue.distribution.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="total_percentage"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_revenue_distribution_template_form" model="ir.ui.view">
        <field name="name">syndicate.revenue.distribution.template.form</field>
        <field name="model">syndicate.revenue.distribution.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="total_percentage" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="سطور التوزيع">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="company_id" readonly="1"/>
                                    <field name="fund_box_id"/>
                                    <field name="account_id" readonly="1"/>
                                    <field name="analytic_account_id" readonly="1"/>
                                    <field name="percentage"/>
                                </tree>
                            </field>
                        </page>
                        <page string="ملاحظات">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_revenue_distribution_template" model="ir.actions.act_window">
        <field name="name">قالب توزيع الإيرادات</field>
        <field name="res_model">syndicate.revenue.distribution.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_revenue_distribution_template"
              name="قالب توزيع الإيرادات"
              parent="menu_syndicate_configuration"
              action="action_revenue_distribution_template"
              sequence="30"/>

</odoo>
