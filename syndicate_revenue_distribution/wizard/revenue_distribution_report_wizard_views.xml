<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_revenue_distribution_report_wizard_form" model="ir.ui.view">
        <field name="name">revenue.distribution.report.wizard.form</field>
        <field name="model">revenue.distribution.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Revenue Distribution Report">
                <sheet>
                    <group string="Report Header">
                        <group>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="total_invoice_count" readonly="1"/>
                            <field name="total_revenue" readonly="1" widget="monetary"/>
                            <field name="total_distributed_amount" readonly="1" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Filters">
                            <group>
                                <group>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="company_id"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                                <group>
                                    <field name="fund_box_id"/>
                                    <field name="product_id"/>
                                    <field name="partner_id"/>
                                </group>
                            </group>
                            <group>
                                <field name="result_message" readonly="1" nolabel="1" colspan="4"/>
                                <field name="detail_count" readonly="1"/>
                                <field name="summary_count" readonly="1"/>
                            </group>
                            <button name="action_generate_report"
                                    type="object"
                                    string="Generate Report"
                                    class="btn-primary"/>
                        </page>

                        <page string="Details">
                            <field name="line_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="move_id"/>
                                    <field name="invoice_date"/>
                                    <field name="partner_name" width="180px"/>
                                    <field name="product_display_name" width="320px"/>
                                    <field name="fund_box_id" invisible="1"/>
                                    <field name="fund_box_name" width="220px"/>
                                    <field name="percentage"/>
                                    <field name="original_amount" widget="monetary"/>
                                    <field name="distributed_amount" widget="monetary"/>
                                    <field name="account_id"/>
                                    <field name="analytic_account_id"/>
                                    <field name="company_id"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Summary by Fund Box">
                            <field name="summary_line_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="currency_id" invisible="1"/>
                                    <field name="fund_box_id" invisible="1"/>
                                    <field name="fund_box_name" width="220px"/>
                                    <field name="total_distributed_amount" widget="monetary"/>
                                    <field name="percentage_of_total"/>
                                    <field name="account_id"/>
                                    <field name="analytic_account_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_revenue_distribution_report_wizard" model="ir.actions.act_window">
        <field name="name">تقرير توزيع الإيرادات</field>
        <field name="res_model">revenue.distribution.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_syndicate_reporting"
              name="Reporting"
              parent="menu_syndicate_root"
              sequence="20"/>

    <menuitem id="menu_revenue_distribution_report"
              name="تقرير توزيع الإيرادات"
              parent="menu_syndicate_reporting"
              action="action_revenue_distribution_report_wizard"
              sequence="10"/>

</odoo>
